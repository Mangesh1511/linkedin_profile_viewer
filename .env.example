# LinkedIn credentials for authentication
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_password_here

# API key required by public scraping endpoints (send as X-API-Key)
API_KEY=replace_with_a_long_random_value

# Google Gemini API Key (Required for Vision Scraper endpoints)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Save debug screenshots to debug_screenshots/ folder (Set to false in production)
SAVE_SCREENSHOTS=false
